# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# First manager account, created on first start when there are no users
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# SEED_DEMO=1 adds five sample products (remove for production)
SEED_DEMO=1

# M-Pesa (Daraja). Leave MPESA_ENABLED=0 for cash and card only.
MPESA_ENABLED=0
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_BASE=https://pos.example.com
MPESA_CALLBACK_SECRET=another-long-random-string
